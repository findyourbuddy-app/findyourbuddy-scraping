BACKEND_API_URL=https://api.example.com
SCRAPER_API_KEY=changeme
ETKINLIK_IO_API_TOKEN=
SCHEDULE_INTERVAL_HOURS=6
GEOCODING_DELAY_SECONDS=1.0
