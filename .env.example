BACKEND_API_URL=https://api.example.com
SCRAPER_API_KEY=changeme
ETKINLIK_IO_API_TOKEN=
SCHEDULE_INTERVAL_HOURS=6
GEOCODING_DELAY_SECONDS=1.0
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
# Nominatim's usage policy actively rejects placeholder/example.com-style
# User-Agents with 403 Access Denied -- use a real contact email here.
GEOCODING_USER_AGENT=findyourbuddy-scraper/0.1 (your-real-email@example.com)
CONFIG_PATH=config.json

GEMINI_API_KEY=
# Google periodically retires older Gemini models; "-latest" aliases track
# the current default so this doesn't need updating when that happens.
GEMINI_MODEL=gemini-flash-latest

# If NOVITA_API_KEY is set, event enrichment uses Novita instead of Gemini
# (Gemini stays as fallback when this is left empty).
NOVITA_API_KEY=
NOVITA_BASE_URL=https://api.novita.ai/openai
NOVITA_MODEL=deepseek/deepseek-v4-flash